# Copier en `.env` et remplir. Ne JAMAIS commiter le .env rempli.

# ---------- Serveur ----------
PORT=8080
GIN_MODE=debug

# ---------- Supabase ----------
# URL du projet (publique).
SUPABASE_URL=https://btujpubexjueauevwphw.supabase.co
# Clé service_role : SECRÈTE. Elle contourne les Row Level Security.
# Ne jamais l'exposer au frontend ni la coller dans une conversation.
SUPABASE_KEY=

# ---------- Whop ----------
# Identifiants des deux plans, tels que Whop les nomme (plan_XXXX).
# Ce sont eux que /api/v1/checkout résout à partir du champ « plan »,
# et que le webhook compare pour savoir quelle offre a été achetée.
WHOP_PLAN_ID_MONTHLY=
WHOP_PLAN_ID_ANNUAL=

# Clé d'API du compte Whop, scope membership:cancel. SECRÈTE.
# Sans elle, le bouton « Résilier » répond 503 et renvoie le client
# vers sa page Whop pour résilier lui-même. L'accès reste ouvert :
# un abonné doit toujours pouvoir partir.
WHOP_API_KEY=

# Secret de signature des webhooks. OBLIGATOIRE.
# La vérification est fail-closed : si cette variable est vide, TOUS les
# webhooks sont refusés. C'est volontaire — sans elle, n'importe qui
# pourrait POSTer sur /webhooks/whop et s'octroyer le premium gratuitement.
WHOP_WEBHOOK_SECRET=

# ---------- E-mail ----------
# Fournisseur d'envoi (Resend). SECRÈTE.
# Fail-closed dans l'autre sens qu'AUTH_SECRET : sans cette clé, rien
# n'est envoyé et rien ne casse — un e-mail manquant ne doit jamais faire
# échouer un paiement ou une résiliation.
RESEND_API_KEY=

# Adresse d'expédition, domaine vérifié chez le fournisseur.
# Format accepté : "Grandimi <bonjour@grandimi.com>".
# Sans elle, l'envoi est refusé plutôt que tenté depuis un domaine non
# authentifié — ce qui enverrait tout en spam et abîmerait la réputation
# du domaine durablement.
EMAIL_EXPEDITEUR=

# Plafond d'envois par passage de la tâche quotidienne (défaut 50).
# Ce n'est pas une limite technique mais une rampe de chauffe : le premier
# passage a un arriéré de comptes éligibles, et une salve froide depuis un
# domaine neuf est la façon classique de se faire bloquer par Gmail.
EMAIL_RELANCE_MAX_PAR_JOUR=50

# ---------- Adresses publiques ----------
# Servent à construire les liens des e-mails. Les valeurs par défaut sont
# celles de la production ; à renseigner pour un environnement de test,
# sinon un lien de désinscription émis en recette pointerait vers la
# production et désinscrirait un vrai compte.
API_URL=https://grandimi-api.onrender.com
SITE_URL=https://grandimi.com

# ---------- Authentification ----------
# Signe les jetons de session ET les liens de désinscription (sur un
# message préfixé, pour que les deux familles ne soient jamais
# interchangeables). 32 caractères minimum, sinon tout est refusé.
AUTH_SECRET=

# Jeton du panneau d'administration, et de la tâche d'envoi quotidienne
# appelée par GitHub Actions.
ADMIN_TOKEN=
