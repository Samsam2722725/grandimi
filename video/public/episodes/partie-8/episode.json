  "lines": [
    {
      "id": "hook",
      "pause": 0,
      "text": "Jusqu’à quelle taille peux-tu grandir ?"
    },
    {
      "id": "partie",
      "pause": 0,
      "text": "Partie 8."
    },
    {
      "id": "dan",
      "pause": 0,
      "text": "Aujourd’hui, on vérifie les statistiques de Luca."
    },
    {
      "id": "age",
      "pause": 0,
      "text": "À 13 ans, Luca mesure actuellement 1m85, ce qui est au-dessus de la moyenne."
    },
    {
      "id": "grandimi",
      "pause": 0,
      "text": "Selon Grandimi.com, sa taille adulte estimée est de 2m03."
    },
    {
      "id": "habitudes",
      "pause": 0,
      "text": "Et avec les bonnes habitudes, Luca pourrait atteindre presque 2m13,"
    },
    {
      "id": "optim",
      "pause": 0,
      "text": "soit 5 cm supplémentaires grâce à l’optimisation de sa croissance."
    },
    {
      "id": "pct",
      "pause": 0,
      "text": "Actuellement, Luca est déjà plus grand que 99,6 % des jeunes de son âge,"
    },
    {
      "id": "fini",
      "pause": 0,
      "text": "et il a terminé 91,3 % de sa croissance."
    },
    {
      "id": "foutu",
      "pause": 0,
      "text": "T’es clairement pas foutu !"
    },
    {
      "id": "geant",
      "pause": 0,
      "text": "Tu vas devenir un véritable géant !"
    },
    {
      "id": "cta",
      "pause": 0,
      "text": "Si toi aussi tu veux qu’on analyse ton potentiel de croissance, commente TAILLE sous cette vidéo."
    }
  ],
